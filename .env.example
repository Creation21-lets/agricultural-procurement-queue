# Copy this file to .env and edit. Lines starting with # are ignored.

# REQUIRED in production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the SQLite database file lives (default: backend/fasal.db)
# DATABASE=/var/data/fasal.db

# Server address (development server only)
HOST=127.0.0.1
PORT=3000

# Only needed if the front end is hosted on a DIFFERENT domain than the API.
# Comma-separated list of allowed origins, e.g. https://fasaltoken.example.com
# CORS_ORIGINS=

# Pakistan has no daylight saving: UTC+5
TZ_OFFSET_HOURS=5

# Hours a sign-in lasts
TOKEN_HOURS=12

# Password given to farmers added by an administrator. Change it.
DEFAULT_FARMER_PASSWORD=demo123

# Most open bookings one farmer may hold at a time
MAX_ACTIVE_BOOKINGS=5
